generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String               @unique
  username           String               @unique
  name               String?
  telephone          String?
  bio                String?
  avatar_url         String?
  email_verified     Boolean?             @default(false)
  last_login_at      DateTime?            @db.Timestamptz(6)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  conversation_users conversation_users[]
  email_tokens       email_tokens[]
  likes              likes[]
  messages           messages[]
  posts              posts[]
  saved_posts        saved_posts[]
  sessions           sessions[]

  @@map("users")
}

model conversation_users {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String?        @db.Uuid
  user_id         String?        @db.Uuid
  joined_at       DateTime?      @default(now()) @db.Timestamptz(6)
  conversations   conversations? @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           Users?         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([conversation_id, user_id])
  @@index([conversation_id], map: "idx_conversation_users_conversation")
  @@index([user_id], map: "idx_conversation_users_user")
}

model conversations {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  conversation_users conversation_users[]
  messages           messages[]
}

model email_tokens {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  token_hash  String
  purpose     String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  expires_at  DateTime  @db.Timestamptz(6)
  consumed    Boolean?  @default(false)
  consumed_at DateTime? @db.Timestamptz(6)
  metadata    Json?     @default("{}")
  users       Users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_email_tokens_expires_at")
  @@index([user_id, purpose], map: "idx_email_tokens_user_purpose")
}

model likes {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  post_id    String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  posts      posts?    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      Users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, post_id])
  @@index([post_id], map: "idx_likes_post")
  @@index([user_id], map: "idx_likes_user")
}

model messages {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String?        @db.Uuid
  sender_id       String?        @db.Uuid
  content         String
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  read_at         DateTime?      @db.Timestamptz(6)
  conversations   conversations? @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           Users?         @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id], map: "idx_messages_conversation")
  @@index([sender_id], map: "idx_messages_sender")
}

model posts {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?       @db.Uuid
  content     String?
  image_url   String?
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?     @default(now()) @db.Timestamptz(6)
  likes       likes[]
  users       Users?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  saved_posts saved_posts[]

  @@index([created_at], map: "idx_posts_created_at")
  @@index([user_id], map: "idx_posts_user")
}

model saved_posts {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id  String?   @db.Uuid
  post_id  String?   @db.Uuid
  saved_at DateTime? @default(now()) @db.Timestamptz(6)
  posts    posts?    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    Users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, post_id])
  @@index([post_id], map: "idx_saved_posts_post")
  @@index([user_id], map: "idx_saved_posts_user")
}

model sessions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String?   @db.Uuid
  refresh_token_hash String
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  expires_at         DateTime  @db.Timestamptz(6)
  last_used_at       DateTime? @db.Timestamptz(6)
  ip                 String?
  user_agent         String?
  revoked            Boolean?  @default(false)
  users              Users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([refresh_token_hash], map: "idx_sessions_refresh_hash")
  @@index([user_id], map: "idx_sessions_user")
}
